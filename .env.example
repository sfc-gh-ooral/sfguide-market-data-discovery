# Live mode. Copy to .env.local (git-ignored) after running sql/setup.sql.
# Leave this file absent to run on the bundled synthetic data with no account.

# Account identifier in <org>-<account> form, and the user that ran setup.sql
# (setup grants MDD_ANALYST_ROLE to that user).
SNOWFLAKE_ACCOUNT=<orgname>-<account_name>
SNOWFLAKE_USERNAME=<YOUR_USER>

# Key-pair authentication (recommended). Keep the key outside the repository.
#   openssl genrsa 2048 | openssl pkcs8 -topk8 -inform PEM -out ~/.snowflake/keys/mdd_rsa_key.p8 -nocrypt
#   openssl rsa -in ~/.snowflake/keys/mdd_rsa_key.p8 -pubout
#   ALTER USER <YOUR_USER> SET RSA_PUBLIC_KEY_2 = '<public key body>';
SNOWFLAKE_PRIVATE_KEY_PATH=/absolute/path/to/mdd_rsa_key.p8

# Optional overrides (defaults shown)
# SNOWFLAKE_ROLE=MDD_ANALYST_ROLE
# SNOWFLAKE_WAREHOUSE=MDD_WH
# SNOWFLAKE_AGENT_NAME=MARKET_DATA_DISCOVERY.FIRM.MARKET_DATA_AGENT
